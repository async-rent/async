{
  // Database upkeep only. This config has no `main` and is never deployed; it
  // exists so `wrangler d1 migrations apply` can bring every Async database up
  // to date. Migration SQL is generated by drizzle-kit in packages/db.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "async-rent",
  "compatibility_date": "2026-10-19",
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "async-rent",
      "database_id": "bbc0d9b6-f588-4f08-8f53-171d6cb007ce",
      "migrations_dir": "packages/db/migrations",
    },
  ],
  "env": {
    "dev": {
      "name": "async-rent-dev",
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_dev",
          "database_id": "eaf08e17-dbae-4820-be5d-31e41b5dbd63",
          "migrations_dir": "packages/db/migrations",
        },
      ],
    },
    "staging": {
      "name": "async-rent-staging",
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_staging",
          "database_id": "129d6859-a153-4f65-bd7a-b69a142fd426",
          "migrations_dir": "packages/db/migrations",
        },
      ],
    },
  },
}
