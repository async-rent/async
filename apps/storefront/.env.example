# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# PayPal sandbox REST app that takes checkout payments. Without them the shop
# still works, and checkout says PayPal isn't available.
# Enable vaulting on the app, since later weeks are charged to the saved account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
