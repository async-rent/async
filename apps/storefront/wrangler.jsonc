{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "async-rent-storefront",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true,
  },
  // Same database as the root wrangler.jsonc, which applies its migrations.
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "async-rent",
      "database_id": "bbc0d9b6-f588-4f08-8f53-171d6cb007ce",
    },
  ],
  "env": {
    "dev": {
      "name": "async-rent-storefront-dev",
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_dev",
          "database_id": "eaf08e17-dbae-4820-be5d-31e41b5dbd63",
        },
      ],
    },
    "staging": {
      "name": "async-rent-storefront-staging",
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_staging",
          "database_id": "129d6859-a153-4f65-bd7a-b69a142fd426",
        },
      ],
    },
  },
}
