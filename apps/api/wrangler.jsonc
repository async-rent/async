{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "async-rent-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "public" },
  "observability": {
    "enabled": true,
  },
  // Hourly weekly billing: each run charges every rental whose next week is
  // due, and replays any charge whose outcome a previous run did not learn.
  "triggers": { "crons": ["0 * * * *"] },
  // Same database as the root wrangler.jsonc, which applies its migrations.
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "async-rent",
      "database_id": "bbc0d9b6-f588-4f08-8f53-171d6cb007ce",
    },
  ],
  "secrets": { "required": ["PAYPAL_CLIENT_ID", "PAYPAL_CLIENT_SECRET"] },
  "env": {
    "dev": {
      "name": "async-rent-api-dev",
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_dev",
          "database_id": "eaf08e17-dbae-4820-be5d-31e41b5dbd63",
        },
      ],
      "secrets": { "required": ["PAYPAL_CLIENT_ID", "PAYPAL_CLIENT_SECRET"] },
    },
    "staging": {
      "name": "async-rent-api-staging",
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "async-rent_staging",
          "database_id": "129d6859-a153-4f65-bd7a-b69a142fd426",
        },
      ],
      "secrets": { "required": ["PAYPAL_CLIENT_ID", "PAYPAL_CLIENT_SECRET"] },
    },
  },
}
