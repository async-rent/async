{
  // The Worker. Widget sources run in the browser and type-check with src/widgets/tsconfig.json.
  "exclude": ["src/widgets", "dist", "node_modules"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["vite/client"]
  }
}
