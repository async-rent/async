{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "async-rent-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "async-rent-db",
      "database_id": "",
    },
  ],
  "vars": {
    "STOREFRONT_URL": "https://storefront.example.com",
    "PAYPAL_CLIENT_ID": "",
    "PAYPAL_CLIENT_SECRET": "",
    "PAYPAL_SANDBOX": "true",
  },
}
